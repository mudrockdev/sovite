#!/bin/sh
# Refuses the commit when lint or Dialyzer fails.
# Enabled by `mix setup` (git config core.hooksPath .githooks).
# Note: checks the working tree, not only the staged changes.
set -e
cd "$(git rev-parse --show-toplevel)"

set "MIX_ENV=test"

echo "pre-commit: mix lint"
if ! mix lint; then
  echo "pre-commit: mix lint failed, commit refused" >&2
  unset MIX_ENV
  exit 1
fi

echo "pre-commit: mix dialyzer"
if ! mix dialyzer; then
  echo "pre-commit: mix dialyzer failed, commit refused" >&2
  unset MIX_ENV
  exit 1
fi

unset MIX_ENV
