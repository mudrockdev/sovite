# Sovite mail transfer agent.
#
# Install the release in /opt/sovite (the .deb and .rpm packages do),
# then: systemctl enable --now sovite
# For socket activation, enable sovite.socket instead; see that file.
[Unit]
Description=Sovite mail transfer agent
Documentation=https://github.com/mudrockdev/sovite
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=sovite
Group=sovite
Environment=SOVITE_CONFIG=/etc/sovite/sovite.toml
# sovitectl talks to the server over the admin API: no Erlang distribution.
Environment=RELEASE_DISTRIBUTION=none
Environment=HOME=/var/lib/sovite
ExecStartPre=/opt/sovite/bin/sovitectl config check
ExecStart=/opt/sovite/bin/sovite start
# Waits for the reload and fails if the config file is invalid.
ExecReload=/opt/sovite/bin/sovitectl config reload
# server.shutdown_timeout (30s by default) for the drain, and some margin.
TimeoutStopSec=60
WatchdogSec=60
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

StateDirectory=sovite
StateDirectoryMode=0750
ConfigurationDirectory=sovite
ConfigurationDirectoryMode=0750
LogsDirectory=sovite
LogsDirectoryMode=0750
ReadWritePaths=/var/spool/sovite
UMask=0027

# Ports 25, 465, and 587. Not needed with socket activation.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
# The BEAM JIT maps code memory executable.
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
