# Sovite configuration
#
# Copy to /etc/sovite/sovite.toml (or point $SOVITE_CONFIG at it) and check it
# with `sovitectl config check`. Every setting is optional; the values below
# are the defaults. See docs/configuration.md for the full reference.

[server]
# Fully qualified name used in the SMTP greeting, EHLO, and Received: headers.
# Defaults to the system hostname, which is often not fully qualified.
# hostname = "mail.example.com"

[database]
# Where users and other data are kept: "sqlite" (default), "postgres", or "mysql".
adapter = "sqlite"
path = "/var/lib/sovite/sovite.db"
# url = "postgres://sovite:secret@db.example.com/sovite"   # postgres or mysql

[queue]
# Spool directory. Must be owned by the sovite user and not readable by others.
directory = "/var/spool/sovite"
# Bounce what is still undelivered after this long.
max_lifetime = "5d"
# Wait between delivery attempts: doubles from min_backoff up to max_backoff.
min_backoff = "5m"
max_backoff = "1h"
# Tell the sender once when a message is still undelivered after this long.
# delay_warning = "4h"

# Where to accept SMTP. Repeat the table for more addresses; add "::" for IPv6.
# mode = "smtp" (port 25), "submission" (587, STARTTLS and AUTH required),
# or "submissions" (465, implicit TLS and AUTH required).
[[listener]]
address = "0.0.0.0"
port = 25

# Mail clients. These need a certificate in [tls].
# [[listener]]
# address = "0.0.0.0"
# mode = "submission"
#
# [[listener]]
# address = "0.0.0.0"
# mode = "submissions"

[tls]
# TLS 1.2 and 1.3 only, with forward-secret AEAD ciphers. "1.3" drops 1.2.
min_version = "1.2"
# Check certificate files for changes this often and reload them.
reload_interval = "1m"

# Certificate chain (certificate first, then intermediates) and its key.
# Repeat for more names, or an RSA and an ECDSA certificate; clients pick by SNI.
# [[tls.certificate]]
# cert_file = "/etc/sovite/tls/mx.example.com.pem"
# key_file = "/etc/sovite/tls/mx.example.com.key"

# Or get one from Let's Encrypt. The CA connects to port 80 to check the names.
# [tls.acme]
# enabled = true
# domains = ["mx.example.com"]
# email = "postmaster@example.com"
# accept_terms = true

[smtp]
# Largest message accepted: bytes, or a number with K, M, or G.
max_message_size = "25M"
max_recipients = 100
max_connections = 1000
max_connections_per_ip = 20
# Error replies before the session is closed.
max_errors = 10
# Seconds, or a number with ms, s, m, h, or d.
command_timeout = "5m"
data_timeout = "5m"
# "reject" closes sessions that send a bare LF or CR; "normalize" converts
# them to CRLF. Only <CRLF>.<CRLF> ever ends a message.
bare_line_endings = "reject"
# Answer VRFY from domains.local_recipients.
vrfy = false
# Clients that may relay to any domain. Empty: relay for no one.
trusted_networks = []

[domains]
# Domains this server is the final destination for. Defaults to the hostname.
# local = ["example.com"]
# Domains accepted from anyone and forwarded, for example as a backup MX.
relay = []
# The only addresses that exist at local domains. Unset: accept any address.
# local_recipients = ["postmaster@example.com", "alice@example.com"]

[routing]
# Where mail for each domain class goes. Hand hosted mailboxes to Dovecot:
# mailbox_transport = "lmtp:unix:/run/dovecot/lmtp"
# local_transport = "local"

[maildir]
# Maildir folders for the "local" and "mailbox" transports. Unset: such
# mail is deferred.
# local = "/var/mail/{user}/"
# mailbox = "/var/vmail/{domain}/{user}/"

# Commands for "pipe:<name>" transports, run once per recipient.
# [pipe.procmail]
# command = ["/usr/bin/procmail", "-d", "{user}"]

[delivery]
# Send all outbound mail through this server. "[host]:port" skips the MX
# lookup. Unset: deliver to each recipient domain's MX hosts.
# relayhost = "[smtp.example.net]:587"
max_deliveries = 100
destination_concurrency = 20
# Wait between deliveries to the same destination.
# destination_rate_delay = "1s"
# Recipients per SMTP transaction.
max_recipients = 50
# Server addresses tried per delivery attempt.
max_addresses = 5
# IP versions to deliver over, preferred first.
ip_versions = ["ipv6", "ipv4"]
connect_timeout = "30s"
# TLS to other servers: none, may (opportunistic), encrypt, verify, or dane.
# "dane" needs a local DNSSEC-validating resolver.
tls = "may"
# tls_policy = { "example.com" = "verify" }
# Log in to the relay host (only over TLS).
# relayhost_username = "user"
# relayhost_password = "secret"

[auth]
# Users for SMTP AUTH: "database" (sovitectl user add ...), "file", "ldap",
# or "dovecot".
backend = "database"
# Offer AUTH without TLS. Leave this off.
plaintext = false
# Ban a client address after this many failed logins within failure_window.
max_failures = 10
failure_window = "10m"
ban_time = "1h"
# Authenticated users may only send as their login and the addresses mapped
# to them here or with `sovitectl user sender add`.
sender_check = true

# [auth.senders]
# "alice@example.com" = ["sales@example.com", "@example.org"]

# [auth.file]
# path = "/etc/sovite/users"         # lines of user:hash, see sovitectl hash-password

# [auth.ldap]
# servers = ["ldap.example.com"]
# base = "ou=people,dc=example,dc=com"
# filter = "(mail=%u)"

# [auth.dovecot]
# socket = "/run/dovecot/auth-client"

[submission]
# Header fields removed from messages of authenticated clients.
strip_headers = ["Return-Path"]

# Email authentication. Mail from outside is checked with SPF, DKIM, ARC,
# and DMARC, and the results are added as an Authentication-Results field.
# `sovitectl dns records example.com` prints the DNS records to publish.
[spf]
verify = true
# Refuse MAIL when SPF fails. DMARC usually makes the better decision.
reject_fail = false

[dkim]
verify = true
# Sign mail from users with the keys below. Make a key with:
#   sovitectl dkim generate example.com s2026 /etc/sovite/dkim/example.com.pem
sign = true

# [[dkim.key]]
# domain = "example.com"
# selector = "s2026"
# file = "/etc/sovite/dkim/example.com.pem"

[arc]
verify = true
# Seal mail that aliases forward to other domains, with a [[dkim.key]].
# seal = true
# domain = "example.com"
# selector = "s2026"
# Forwarders and lists whose seals may override a failing DMARC policy.
trusted_sealers = []

[dmarc]
# "report": only record results. "enforce": refuse or hold failing mail as
# the sender's policy asks.
policy = "report"
# Send aggregate reports to the domains whose mail you receive.
reports = false

[srs]
# Rewrite the sender of mail forwarded to other domains, so SPF still
# passes there.
enabled = false
# secrets = ["a long random string"]

[bounce]
# Where to report notifications that could not be delivered. Unset: log only.
# double_bounce_recipient = "postmaster@example.com"

[log]
# One of: debug, info, notice, warning, error
level = "info"
# "text" for classic log lines, "json" for one JSON object per line
format = "text"

# Write logs to rotating files in this directory instead of standard output.
# The settings below only apply when this is set.
# directory = "/var/log/sovite"
# {date} is the date formatted with date_format (strftime), {n} the file
# number, which goes up with each rotation. {n} is required.
file_name = "sovite.{date}.{n}.log"
date_format = "%Y-%m-%d"
# Start a new file before the current one grows past this size: bytes, or a
# number with K, M, or G (1024-based), for example "512M" or "1G".
max_size = "100M"
# Also start a new file every: never, hourly, daily, weekly, monthly
rotation = "daily"
# Log files to keep, including the current one. 0 keeps all.
max_files = 14
# Symlink in the directory that always points to the current file.
# symlink = "current.log"
